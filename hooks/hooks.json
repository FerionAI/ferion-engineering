{
  "description": "Injects the engineering standard at session start (with the current flow step) and ENFORCES the mandatory flow issue -> in progress -> implement -> local review -> PR + cost -> in review: the flow-gate.sh gates block (exit 2) editing code without an assumed issue (or another group's code in the same session), opening a PR without local review, without a spec on the branch or without every issue's reference, labelling for review without PR/MR + cost, and labelling for QA (the tech lead's phase, skill approve) without the PR/MR approved by a human and CI green; PostToolUse stamps each milestone from what the tool actually did. It also blocks AI signatures on commits and PRs (P3). At session start it also reports which declared data sources have no credential configured; blocking a skill on that is opt-in (see the `integrations` skill). And it warns when the installed plugin is behind the latest release (hooks/check-version.sh: daily cache, refreshed in the background), because a third-party marketplace does not update itself.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/session-banner.md\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" status",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-sources.sh\" banner",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/check-version.sh\" banner",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate edit",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/no-ai-signature.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate bash-edit",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate pr",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate review-label",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*(create_pull_request|pull_request_create|create_merge_request|merge_request_create)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate pr",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*(update_issue|issues_update|issue_write)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" gate review-label",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*(issue|pull_request|merge_request)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-gate.sh\" post",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
